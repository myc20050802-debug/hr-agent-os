# ============================================================
#  HR-Agent OS · 环境变量示例
#  ------------------------------------------------------------
#  用法：复制成 server/.env 再改（server/.env 已在 .gitignore 里，
#        绝不会被提交；**这个示例文件会入库，所以不要往里填真实密钥**）。
#
#  优先级：真实环境变量 > server/.env > 代码里的默认值。
#  所有值都有合理默认，本地演示**不需要**任何配置。
# ============================================================

# ---------- 运行环境 ----------
# development（默认）| production
# production 会启用两条硬约束（配置不合规直接拒绝启动）：
#   ① 必须 COOKIE_SECURE=1（禁止明文 http 传会话 Cookie）
#   ② 演示重置 ALLOW_RESET 默认关闭
NODE_ENV=development

# ---------- 网络 ----------
# 只监听本机（默认）。要让局域网/容器访问改为 0.0.0.0，
# 但**不要**在没上 TLS 的情况下直接暴露公网。
HOST=127.0.0.1
PORT=8788
# 请求体上限（字节）。当前未见文件上传入口，8MB 是留白
MAX_BODY_BYTES=8388608
# 优雅关闭等待在途请求的上限（毫秒）
SHUTDOWN_GRACE_MS=5000

# ---------- 会话与认证 ----------
# 会话签名密钥。**留空即可**：服务会生成一个并落盘到 .session_secret(0600)。
# 只有「多实例共享会话」或「容器无持久盘」时才需要显式指定。
# 低于 16 字符会被配置校验拒绝。
# SESSION_SECRET=

# 密钥落盘路径（默认 server/.session_secret）。
# 容器/私有化部署建议指向挂载卷，否则容器重建=所有人被踢下线。
# SESSION_SECRET_FILE=/var/lib/hr-agent/.session_secret

# 会话有效期（毫秒），默认 12 小时
SESSION_TTL_MS=43200000
# 会话 Cookie 名
SESSION_COOKIE=hr_session
# 是否要求 HTTPS 传输 Cookie（1/true/yes/on）。
# ⚠️ 必须与访问方式成对出现：
#   用 https 访问 → 设 1（生产环境强制）
#   用 http  访问 → 必须留空/0，否则浏览器不发送 Cookie，
#                    表现为「登录成功后立刻又回到登录页」
COOKIE_SECURE=

# ---------- 数据 ----------
# SQLite 库文件路径（默认 server/hr_agent.db）。
# ⚠️ 容器化必改：指向挂载卷，否则容器重建数据即丢。
# 备份工具 tools/backup.js 读的是同一个变量 —— 改这里，备份目标跟着变。
# DB_PATH=/var/lib/hr-agent/hr_agent.db

# ---------- 演示维护 ----------
# 是否开放「重置演示数据」：
#   · POST /api/reset（右上角 ♻ 按钮）会**清空运行期表**
#   · 命令行 --reset 会让服务启动时重建库
# 默认值：开发环境开、生产环境关。
# ⚠️ 公网实例务必保持关闭 —— 它省下的只是「重启一次」的功夫。
# ALLOW_RESET=1

# ---------- 限流 ----------
RATE_LIMIT=1
# 登录：按 IP+账号双维度，容量 / 每秒补充
RL_LOGIN_CAP=10
RL_LOGIN_REFILL=0.1667
# 通用 API：按身份
RL_API_CAP=600
RL_API_REFILL=10

# ---------- 日志 ----------
# debug | info | warn | error
LOG_LEVEL=info
# 置空则只输出到 stdout（容器里推荐置空，交给采集器）
# LOG_FILE=server/logs/app.log
# 是否人类可读格式（1=带颜色/缩进；生产建议 0 走 JSON）
LOG_PRETTY=

# ---------- LLM（可选） ----------
# 三项都配齐才会启用；不配则全程走规则引擎（离线可用、可回归）。
# 只影响「筛选打分」与「JD 润色」两处，且失败自动退回规则产物。
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=20000

# ---------- 数据治理 ----------
# 候选人信息默认留存天数，到期由维护任务匿名化
DEFAULT_RETAIN_DAYS=180
# 入库到「人才库（储备）」是否必须候选人单独同意
CONSENT_REQUIRED=1
