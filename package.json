{
  "name": "hr-agent-os",
  "version": "0.10.0",
  "private": false,
  "description": "B 端 HR AI Agent 平台 · 可运行的本地全栈 PoC。运行时零依赖（Node 原生 http + 内置 node:sqlite）；jsdom 仅用于前端无头测试。",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite server/server.js",
    "start:reset": "node --experimental-sqlite server/server.js --reset",
    "dev": "node tools/dev-up.js",
    "dev:restart": "node tools/dev-up.js --restart",
    "build": "node 平台原型/build.js",
    "backup": "node tools/backup.js",
    "backup:list": "node tools/backup.js --list",
    "preflight": "node --experimental-sqlite tools/preflight.js",
    "test": "node tools/run_all.js && node tools/check_docs.js && node --experimental-sqlite tools/eval_dual_mode.js",
    "check:docs": "node tools/check_docs.js",
    "test:dual": "node --experimental-sqlite tools/eval_dual_mode.js",
    "eval:dual": "node --experimental-sqlite tools/eval_dual_mode.js --md docs/16_规则与LLM双模式对照评测.md",
    "share": "python tools/build_share_pack.py",
    "build:portfolio": "cd frontend && npm run build -- --outDir dist && cd .. && python tools/build_portfolio_single.py",
    "verify:portfolio": "python frontend/scripts/verify-single-file.py",
    "test:backend": "node tools/run_all.js --only backend",
    "test:frontend": "node tools/run_all.js --only frontend",
    "test:load": "node tools/run_all.js --only load",
    "test:devup": "node tools/test_devup.js",
    "test:ops": "node --experimental-sqlite tools/test_ops.js",
    "test:auth": "node --experimental-sqlite tools/test_auth.js",
    "test:hiring": "node --experimental-sqlite tools/test_hiring.js",
    "test:jd": "node --experimental-sqlite tools/test_jd.js",
    "test:eval": "node --experimental-sqlite tools/test_eval.js",
    "test:screening": "node --experimental-sqlite tools/test_screening.js",
    "test:offline": "node 平台原型/test_prototype.js",
    "test:pages": "node 平台原型/test_pages.js",
    "test:live": "node 平台原型/test_live.js"
  },
  "devDependencies": {
    "jsdom": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myc20050802-debug/hr-agent-os.git"
  },
  "homepage": "https://myc20050802-debug.github.io/hr-agent-os/",
  "bugs": {
    "url": "https://github.com/myc20050802-debug/hr-agent-os/issues"
  },
  "keywords": [
    "hr",
    "recruiting",
    "ai-agent",
    "llm",
    "human-in-the-loop",
    "explainable-ai",
    "sqlite",
    "zero-dependency",
    "nodejs",
    "poc"
  ],
  "author": "Ma Yunchong"
}
