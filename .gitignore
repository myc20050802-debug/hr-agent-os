# ============================================================
#  HR-Agent OS · 忽略清单
#  原则：运行时产物、密钥、PII 数据一律不入库；
#        源码、迁移脚本、测试、文档全部入库。
# ============================================================

# ---- 1. 运行时数据库（含候选人 PII 原文，绝不入库）----
# 库不存在时后端会自动种子重建，因此入库没有意义、只有风险
server/hr_agent.db
server/hr_agent.db-shm
server/hr_agent.db-wal
server/*.db
server/*.db-shm
server/*.db-wal

# ---- 2. 密钥与日志 ----
# .session_secret 是服务端会话签名密钥，泄露即可伪造任意身份
server/.session_secret
server/logs/
*.log

# ---- 2b. 本地环境配置 ----
# server/.env 里可能有 SESSION_SECRET / LLM_API_KEY，必须忽略；
# 而 .env.example 是**给别人的说明书**，一定要入库。
server/.env
!server/.env.example

# ---- 2c. 数据库备份 ----
# 备份里是完整的候选人 PII，且体积大、可随时重生成 —— 不入库
backups/

# ---- 3. 测试运行产物（结果文件，非测试代码）----
_test_*.txt
tools/_test_*.txt
平台原型/_t_*.txt
tools/_cache/

# ---- 4. 生成的分享包（由 平台原型/build.js 产出，已过期副本）----
分享包/

# ---- 5. 工具与操作系统噪声 ----
# .workbuddy/ 下大部分是本机工作记忆（个人，不入库），
# 但 settings.json 是**项目级 hook 配置**（SessionStart → tools/dev-up.sh，
# 即「打开项目就自动拉起后端」那条链路）—— 它是要共享的，必须入库。
.workbuddy/*
!.workbuddy/settings.json
__pycache__/
*.py[cod]
node_modules/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 测试/评测/压测的产物（每次运行都会重算，不入库；数字写进 README 与 docs）
_run_all.txt
_eval_result.json
_load_result.json

# ---- 6. 一次性排查脚本与其产物（用完即弃，不入库）----
# 例：为验证 VACUUM INTO 写的临时脚本 / 套件输出重定向文件
_*.txt
_*.json
_*.db
_*.js
!tools/dev-up.js
