{
  "name": "ppt-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir ../artifacts",
    "preview": "vite preview --outDir ../artifacts",
    "preview:deck": "vite preview --port 5180 --strictPort",
    "build:slides": "rm -rf ./dist-slides && node scripts/build-slides.js",
    "shoot:slides": "python scripts/shoot-slides.py --url http://127.0.0.1:5180 -o public/assets/images/posters/pages",
    "build:pptx": "node scripts/make-pptx.cjs public/assets/images/posters/pages ../docs/pages.json ../artifacts/HR-Agent-OS_作品集_19页.pptx"
  },
  "dependencies": {
    "juice": "^11.1.0",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "vite": "^7.2.2",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32"
  }
}
